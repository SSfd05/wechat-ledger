.page {
  padding: 28rpx 32rpx 60rpx;
}

.card + .card {
  margin-top: 24rpx;
}

.title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.6;
}

.input {
  width: 100%;
  height: 280rpx;
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #faf7f2;
  font-size: 27rpx;
  line-height: 1.7;
}

.ph {
  color: #bdb5a9;
}

.actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}

.ghost-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 24rpx;
}

.parse-btn {
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 25rpx;
  font-weight: 600;
}

.preview-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.preview-total {
  font-size: 25rpx;
  color: var(--accent);
  font-weight: 600;
}

.item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.item-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex: none;
}

.item-main {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
}

.item-note {
  display: block;
  font-size: 26rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item-sub {
  display: block;
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.item-amount {
  font-size: 26rpx;
  font-weight: 600;
  flex: none;
}

.item-amount.income {
  color: #2f9e6e;
}

.item-remove {
  flex: none;
  width: 46rpx;
  height: 46rpx;
  margin-left: 8rpx;
  border-radius: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b8b0a4;
  font-size: 30rpx;
}

.save-btn {
  margin-top: 26rpx;
}

.tip-card {
  margin-top: 24rpx;
  padding: 26rpx 30rpx;
  border-radius: 26rpx;
  background: rgba(232, 102, 61, 0.06);
  border: 1rpx solid rgba(232, 102, 61, 0.14);
}

.tip-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent);
}

.tip-text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a6a5c;
  line-height: 1.7;
}

.soft-hover {
  opacity: 0.7;
}
