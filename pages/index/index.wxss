.page {
  padding: 24rpx 32rpx 180rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 26rpx;
}

.greet {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.date {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.settings-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(38, 34, 29, 0.06);
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 36rpx 32rpx;
  border-radius: 40rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #d95b33 0%, #e8663d 46%, #f0935f 100%);
  box-shadow: 0 24rpx 60rpx rgba(217, 91, 51, 0.26);
}

.hero::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -90rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-label {
  font-size: 25rpx;
  opacity: 0.9;
  letter-spacing: 2rpx;
}

.hero-month {
  font-size: 23rpx;
  opacity: 0.86;
}

.hero-amount {
  margin-top: 16rpx;
  font-size: 86rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: 1rpx;
}

.cny {
  font-size: 38rpx;
  font-weight: 500;
  margin-right: 8rpx;
}

.hero-budget {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.94;
}

.hero-link {
  text-decoration: underline;
}

.hero-income {
  margin-top: 10rpx;
  font-size: 23rpx;
  opacity: 0.9;
}

.hero-track {
  margin-top: 18rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.26);
  overflow: hidden;
}

.hero-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #ffffff;
  transition: width 0.3s ease;
}

.hero-fill.over {
  background: #ffe08a;
}

.section {
  margin-top: 38rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 6rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.section-link {
  font-size: 23rpx;
  color: var(--muted);
}

.cats-card {
  padding: 10rpx 26rpx;
}

.cat-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.cat-row + .cat-row {
  border-top: 1rpx solid var(--line);
}

.cat-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex: none;
}

.cat-main {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.cat-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.cat-amount {
  font-weight: 600;
}

.cat-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: #f3ede5;
  overflow: hidden;
}

.cat-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.cat-pct {
  width: 74rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--muted);
  flex: none;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 52rpx 32rpx;
  text-align: center;
}

.empty-icon {
  font-size: 64rpx;
}

.empty-title {
  margin-top: 16rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.empty-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.empty-btn {
  display: inline-block;
  width: auto;
  margin-top: 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 44rpx;
  border-radius: 36rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 26rpx;
}

.recent-card {
  padding: 8rpx 26rpx;
}

.rec {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.rec + .rec {
  border-top: 1rpx solid var(--line);
}

.rec-hover {
  background: #fbf8f3;
  border-radius: 20rpx;
}

.rec-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex: none;
}

.rec-main {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.rec-note {
  display: block;
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rec-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.rec-amount {
  font-size: 28rpx;
  font-weight: 600;
  flex: none;
}

.rec-amount.income {
  color: #2f9e6e;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 48rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 4rpx;
  font-size: 54rpx;
  font-weight: 300;
  color: #ffffff;
  background: linear-gradient(135deg, #d95b33 0%, #e8663d 60%, #f0935f 100%);
  box-shadow: 0 16rpx 36rpx rgba(217, 91, 51, 0.36);
  z-index: 20;
}

.summary-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 18, 15, 0.5);
  z-index: 95;
  display: flex;
  align-items: center;
  justify-content: center;
}

.summary-card {
  width: 560rpx;
  background: #fffdf6;
  border-radius: 28rpx;
  padding: 36rpx 40rpx 30rpx;
  border: 2rpx solid #f0e6d2;
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.3);
}

.summary-head {
  text-align: center;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: #2b2a26;
}

.summary-sub {
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.summary-dash {
  border-top: 2rpx dashed #d9cdb8;
  margin: 22rpx 0;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 6rpx 0;
}

.summary-row .out {
  color: #d95b33;
  font-weight: 600;
}

.summary-row .in {
  color: #2f9e6e;
  font-weight: 600;
}

.summary-row.total {
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.summary-budget {
  margin-top: 14rpx;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: #faf3e3;
  color: #8a6a2f;
  font-size: 22rpx;
  text-align: center;
}

.summary-btn {
  margin-top: 26rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
}

.soft-hover {
  opacity: 0.7;
}

/* ---- 宠物 ---- */
.pet-wrap {
  position: fixed;
  left: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
}

.pet-img-wrap {
  width: 168rpx;
  height: 168rpx;
  margin-left: -2rpx;
  margin-bottom: -4rpx;
  flex: none;
  position: relative;
}

.pet-img-wrap.is-custom {
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(38, 34, 29, 0.16);
  margin-left: 0;
  margin-bottom: 6rpx;
}

.pet-img {
  width: 100%;
  height: 100%;
  display: block;
}

.pet-hover {
  opacity: 0.9;
  transform: translateY(2rpx);
}

.pet-bubble {
  margin: 0 0 104rpx 6rpx;
  max-width: 330rpx;
  background: #ffffff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 14rpx 20rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--ink);
  box-shadow: 0 10rpx 24rpx rgba(38, 34, 29, 0.08);
  position: relative;
}

.pet-bubble::before {
  content: '';
  position: absolute;
  left: -16rpx;
  bottom: 28rpx;
  border: 9rpx solid transparent;
  border-right-color: #ffffff;
}

.pet-panel-img-wrap {
  width: 120rpx;
  height: 120rpx;
  flex: none;
}

.pet-panel-img-wrap.is-custom {
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid #f3ede5;
}

.pet-panel-img {
  width: 100%;
  height: 100%;
  display: block;
}

.pet-heard {
  margin-top: 16rpx;
  width: 100%;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
  box-sizing: border-box;
}

/* ---- 语音面板 ---- */
.pet-panel {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
}

.pet-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 18, 15, 0.45);
}

.pet-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #fffdf9;
  border-radius: 36rpx;
  padding: 32rpx;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.25);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pet-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

.pet-head-bubble {
  flex: 1;
  min-height: 96rpx;
  background: #faf6f0;
  border-radius: 24rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  line-height: 1.5;
  display: flex;
  align-items: center;
}

.pet-close {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f3ede5;
  color: var(--muted);
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-listening {
  margin-top: 20rpx;
  width: 100%;
  min-height: 60rpx;
  background: #f3ede5;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.pet-result {
  margin-top: 16rpx;
  width: 100%;
  background: var(--accent-soft);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: var(--accent);
  box-sizing: border-box;
}

.pet-mode {
  display: flex;
  margin-top: 20rpx;
  background: #f3ede5;
  border-radius: 999rpx;
  padding: 6rpx;
}

.pet-mode-item {
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.pet-mode-item.on {
  background: #ffffff;
  color: var(--ink);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(38, 34, 29, 0.08);
}

.pet-mic {
  margin-top: 28rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, #f0935f, #e8663d);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 16rpx 32rpx rgba(232, 102, 61, 0.35);
}

.pet-mic.on {
  background: linear-gradient(160deg, #e8663d, #d95b33);
  transform: scale(1.06);
}

.pet-mic-icon {
  font-size: 56rpx;
  line-height: 1;
}

.pet-mic-label {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.pet-hint {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--muted);
  text-align: center;
}

.pet-undo {
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  color: #c2503a;
  text-decoration: underline;
}
